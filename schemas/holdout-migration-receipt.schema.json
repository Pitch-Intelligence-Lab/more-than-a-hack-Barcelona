{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pitch-intelligence-lab.local/schemas/holdout-migration-receipt.schema.json",
  "title": "Audit-only Holdout migration receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_type",
    "status",
    "promotion_authorized",
    "source_provider",
    "source_holdout_id",
    "source_match_ids",
    "source_protocol_version",
    "source_ledger_head_sha256",
    "legacy_combined_freeze",
    "old_code_commit",
    "migration_commit",
    "migration_tool_sha256",
    "migration_rule_version",
    "model_freeze_spec_sha256",
    "evaluation_freeze_spec_sha256",
    "policy_sha256",
    "old_holdout_manifest_sha256",
    "target_model_identity",
    "target_evaluation_identity",
    "target_split_manifest_sha256",
    "target_holdout_manifest_sha256",
    "governance_identity_digest",
    "approver",
    "approval_evidence_ids",
    "reason",
    "previous_record_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "event_type": {"const": "FREEZE_PROTOCOL_MIGRATED"},
    "status": {"const": "MIGRATED_AUDIT_ONLY"},
    "promotion_authorized": {"const": false},
    "source_provider": {"type": "string", "minLength": 1},
    "source_holdout_id": {"type": "string", "minLength": 1},
    "source_match_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "source_protocol_version": {"const": "combined-policy-model-v1"},
    "source_ledger_head_sha256": {"$ref": "#/$defs/sha256"},
    "legacy_combined_freeze": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "old_code_commit": {"$ref": "#/$defs/commit"},
    "migration_commit": {"$ref": "#/$defs/commit"},
    "migration_tool_sha256": {"$ref": "#/$defs/sha256"},
    "migration_rule_version": {"const": "1.0"},
    "model_freeze_spec_sha256": {"$ref": "#/$defs/sha256"},
    "evaluation_freeze_spec_sha256": {"$ref": "#/$defs/sha256"},
    "policy_sha256": {"$ref": "#/$defs/sha256"},
    "old_holdout_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "target_model_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "feature_set", "configuration", "hyperparameters"],
      "properties": {
        "model": {"$ref": "#/$defs/sha256"},
        "feature_set": {"$ref": "#/$defs/sha256"},
        "configuration": {"$ref": "#/$defs/sha256"},
        "hyperparameters": {"$ref": "#/$defs/sha256"}
      }
    },
    "target_evaluation_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluation_script", "metric_contract_version"],
      "properties": {
        "evaluation_script": {"$ref": "#/$defs/sha256"},
        "metric_contract_version": {"type": "string", "minLength": 1}
      }
    },
    "target_split_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "target_holdout_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "governance_identity_digest": {"$ref": "#/$defs/sha256"},
    "approver": {"type": "string", "minLength": 1},
    "approval_evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "reason": {"type": "string", "minLength": 1},
    "previous_record_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
  }
}
