{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pitch-intelligence-lab.local/schemas/source-identity-set.schema.json",
  "title": "Sealed Holdout SourceIdentitySet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider",
    "members",
    "source_identity_map",
    "source_set_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "provider": {"type": "string", "minLength": 1},
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["match_id", "source_config"],
        "properties": {
          "match_id": {"type": "string", "minLength": 1},
          "source_config": {"type": "string", "minLength": 1}
        }
      }
    },
    "source_identity_map": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "source_set_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
